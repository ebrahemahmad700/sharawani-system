# Copy to .env and change every value below.
#
#   cp .env.example .env
#
# Generate each secret with:  openssl rand -hex 24
# Passwords must not contain the characters |  \  or &

# The postgres superuser, used once to create the five docsys roles.
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser

# Shared by docsys_owner, docsys_app, docsys_readonly, docsys_jobs, docsys_backup.
# They are separate roles with different privileges; only the password is shared,
# and on a real deployment each one gets its own.
DOCSYS_DB_PASSWORD=change-me-database

# Signs the CSRF tokens. If this changes, everyone is signed out. Keep it stable
# and keep it out of version control.
CSRF_SECRET=change-me-csrf-secret

# The password every invented fixture account gets. Development only.
FIXTURE_PASSWORD=guhare-2026

# The port on your machine. The database port is not published at all.
WEB_PORT=3111

# Set to true only when there is TLS in front. A Secure cookie is never sent
# over plain HTTP, so leaving this true without TLS makes login appear to loop.
SECURE_COOKIES=false

# Web push: being told when the browser is shut. Generate once with
#   docker compose run --rm app node scripts/vapid-keys.mjs
# and paste the three lines it prints here. Leave them empty and the bell still
# works inside an open browser; what is missing is the notification on a phone
# with the application closed. Changing the private key later signs every
# registered browser out of push and everyone has to press the button again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:it@rania.gov.krd

# How long one event-stream connection is held before the browser reconnects.
# Ten minutes on a server of our own. Shorten it only if something in front of
# the application cuts long responses.
EVENTS_HOLD_MS=600000

# The corridor wall board. Generate with `openssl rand -hex 24`. Open
# http://SERVER/board?key=<this> once on the machine driving the television and
# it keeps a cookie that grants the board and nothing else. Leave it empty and
# the board still works for the mayor, his deputy and IT when they are signed in.
BOARD_TOKEN=

# --- backup ------------------------------------------------------------------

# REQUIRED on any real deployment. Encrypts every backup before it is written.
# Without it the backup container takes nothing and says so once an hour in
# `docker compose logs backup`.
#
#   openssl rand -base64 32
#
# Write it on paper as well and put it in the mayor's safe. A passphrase kept
# only on the server is not a passphrase: the server is the thing that will be
# gone on the day you need it. Changing it does not re-encrypt old backups, so
# keep the old one until the last backup written with it has been deleted.
BACKUP_PASSPHRASE=

# When. Hours are 0-23 in Asia/Baghdad; the rehearsal day counts Sunday as 0.
BACKUP_HOUR=2
REHEARSE_DAY=0
REHEARSE_HOUR=3

# How many to keep: every backup for this many days, then one a week, then one a
# month. The newest backup is never deleted, and neither is the newest one that
# has passed a rehearsal, whatever these say.
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12

# --- scanners ---------------------------------------------------------------
# Network scanners are added on the Scanners screen (/admin/scanners), not here.
# This switches on a simulated one that "scans" a test page, so the screens can be
# tried before any hardware arrives. Leave it empty on the real server.
SCANNER_SIMULATOR=

# Upload ceiling in bytes; 60 MiB when empty. Only the serverless demo needs it
# lower (4400000), because that host refuses requests over 4.5 MB.
MAX_UPLOAD_BYTES=
